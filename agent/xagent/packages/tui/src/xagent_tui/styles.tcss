/* xagent TUI — OpenCode-inspired dark terminal theme */

Screen {
    layout: vertical;
    background: #0f0f10;
    color: #e7e3da;
}

Header {
    height: 1;
    padding: 0 2;
    background: #0f0f10;
    color: #8b8b93;
    border-bottom: solid #232326;
}

Header .header--title {
    color: #f5a97f;
    text-style: bold;
}

Header .header--sub-title {
    color: #8b8b93;
}

#chat {
    height: 1fr;
    padding: 1 3 0 3;
    scrollbar-size-vertical: 1;
    scrollbar-background: #0f0f10;
    scrollbar-color: #3a3a40;
}

/* ------------------------------------------------------------------ */
/* 消息                                                               */
/* ------------------------------------------------------------------ */

.message {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0;
    background: transparent;
}

.role {
    height: 1;
    width: 100%;
    margin: 0 0 0 0;
}

.role-name {
    width: 1fr;
    text-style: bold;
}

.role-time {
    width: auto;
    color: #5f5f68;
}

.body {
    height: auto;
}

.user {
    padding: 0 0 0 1;
    border-left: thick #f5a97f;
}

.user .role-name {
    color: #f5a97f;
}

.assistant {
    padding: 0;
}

.assistant .role-name {
    color: #a6da95;
}

.meta {
    padding: 0 0 0 1;
    border-left: thick #8aadf4;
    color: #8b8b93;
}

.error {
    padding: 0 0 0 1;
    border-left: thick #ed8796;
    color: #ed8796;
}

Markdown {
    margin: 0;
    padding: 0;
    background: transparent;
}

/* ------------------------------------------------------------------ */
/* 工具调用                                                           */
/* ------------------------------------------------------------------ */

.tool {
    padding: 0 0 0 1;
    border-left: thick #3a3a40;
    background: transparent;
}

.tool-ok {
    border-left: thick #a6da95;
}

.tool-error {
    border-left: thick #ed8796;
}

.tool-header {
    height: 1;
    color: #eed49f;
    text-style: bold;
}

.tool-pending .tool-header {
    color: #eed49f;
}

.tool-ok .tool-header {
    color: #a6da95;
}

.tool-error .tool-header {
    color: #ed8796;
}

.tool-summary {
    height: auto;
    color: #8b8b93;
}

.tool-ok .tool-summary {
    color: #c8c4bb;
}

.tool-error .tool-summary {
    color: #ed8796;
}

.tool-details {
    border-top: none;
    background: transparent;
    padding: 0;
}

.tool-details > Contents {
    padding: 0;
}

.tool-detail {
    height: auto;
    color: #8b8b93;
}

/* ------------------------------------------------------------------ */
/* 欢迎面板                                                           */
/* ------------------------------------------------------------------ */

.welcome {
    width: 100%;
    height: auto;
    margin: 1 0 2 0;
    padding: 0;
    border: none;
    background: transparent;
}

.welcome-title {
    height: 1;
    color: #f5a97f;
    text-style: bold;
}

.welcome-subtitle {
    height: auto;
    color: #8b8b93;
}

.welcome-rule {
    height: 1;
    margin: 1 0;
    border-bottom: solid #232326;
}

.welcome-row {
    height: auto;
    width: 100%;
}

.welcome-label {
    width: 10;
    color: #5f5f68;
}

.welcome-value {
    width: 1fr;
    color: #c8c4bb;
}

/* ------------------------------------------------------------------ */
/* 状态栏                                                             */
/* ------------------------------------------------------------------ */

#status {
    height: 1;
    padding: 0 2;
    background: #0f0f10;
    border-top: solid #232326;
}

.status-spinner {
    width: 2;
    content-align: center middle;
}

.status-idle {
    color: #a6da95;
}

.status-busy {
    color: #eed49f;
}

.status-error {
    color: #ed8796;
}

.status-state {
    width: 28;
    color: #c8c4bb;
}

.status-model {
    width: 30;
    color: #8b8b93;
}

.status-directory {
    width: 1fr;
    color: #5f5f68;
}

/* ------------------------------------------------------------------ */
/* 输入栏                                                             */
/* ------------------------------------------------------------------ */

#prompt-bar {
    height: 3;
    margin: 0 2;
    border: round #3a3a40;
    background: #17171a;
}

#prompt-bar:focus-within {
    border: round #f5a97f;
    background: #1b1b1f;
}

#prompt-bar .prompt-prefix {
    width: 3;
    content-align: center middle;
    color: #f5a97f;
    text-style: bold;
}

#prompt-bar Input {
    height: 1;
    padding: 0 1;
    border: none;
    background: transparent;
    color: #e7e3da;
}

#prompt-bar Input:focus {
    border: none;
    background: transparent;
}

#prompt-bar Input.-placeholder {
    color: #5f5f68;
}

Footer {
    height: 1;
    padding: 0 2;
    background: #0f0f10;
    color: #5f5f68;
}

Footer .footer--key {
    background: #1b1b1f;
    color: #c8c4bb;
}

Footer .footer--description {
    color: #5f5f68;
}
